{
	"game": "walltest",
	"name": "结构墙（冻结读态）",
	"scenarios": [
		{
			"name": "越权写在写入点即抛，活世界零污染；干净裁决与干净读不受影响",
			"steps": [
				{ "name": "干净动作：冻结不误伤", "action": { "verb": "touch", "params": {} }, "expect": { "ok": true, "reason": "触到", "state": { "player.touched": 1, "player.hp": 10 } } },
				{ "name": "规则越权写属性：冻结读态上写入即抛（严格模式 TypeError），授予不存在", "action": { "verb": "poke", "params": {} }, "expect": { "throws": "read only" } },
				{ "name": "规则越权写钟：q.world.time 同被冻结拦下——钟的唯一写者是落钟循环，按构造成立", "action": { "verb": "clockpoke", "params": {} }, "expect": { "throws": "read only" } },
				{ "name": "越权未遂后世界仍健康：时间未走、数值无漂移，干净动作照常", "action": { "verb": "touch", "params": {} }, "expect": { "ok": true, "state": { "player.touched": 2, "player.hp": 10 } } },
				{ "name": "武装系统越权（leak.tick 平时沉默，武装后的刻步才测写入点即抛）", "action": { "verb": "arm", "params": {} }, "expect": { "ok": true } },
				{ "name": "系统越权写属性：刻步在系统写入点即抛", "tick": 1, "expect": { "throws": "read only" } }
			]
		},
		{
			"name": "墙否决的原子回滚：回滚后账本仍可提交（冻结引用不得入账）",
			"steps": [
				{ "name": "合法授予被领域不变式否决：整提交回滚，状态零漂移", "action": { "verb": "trip", "params": {} }, "expect": { "ok": false, "reason": "封印", "state": { "player.vault": null, "player.touched": 0 } } },
				{ "name": "回滚后的干净提交照常（回滚冻结的探针步）", "action": { "verb": "touch", "params": {} }, "expect": { "ok": true, "state": { "player.touched": 1, "player.vault": null } } },
			{ "name": "对象形状值（类型层除名后的 as 夹带）：提交翼拒为非账本值，整提交回滚", "action": { "verb": "smuggle", "params": {} }, "expect": { "ok": false, "reason": "世界没有回应", "state": { "player.note": null, "player.touched": 1 } } },
			{ "name": "夹带被拒后账本仍健康（回滚探针步）", "action": { "verb": "touch", "params": {} }, "expect": { "ok": true, "state": { "player.touched": 2, "player.note": null } } }
			]
		},
		{
			"name": "审查者同权隔离：不变式越权写在冻结读态上即抛，崩溃兑为墙否决——先回滚后拒绝",
			"steps": [
				{ "name": "审查者越权写账本：TypeError 在提交边界兑为 invariant.crash 否决（可说），整提交回滚", "action": { "verb": "sneakpoke", "params": {} }, "expect": { "ok": false, "reason": "世界没有回应", "state": { "player.sneak": null, "player.hp": 10 } } },
				{ "name": "审查者崩溃后账本仍健康：干净提交照常（回滚探针步）", "action": { "verb": "touch", "params": {} }, "expect": { "ok": true, "state": { "player.touched": 1, "player.hp": 10 } } }
			]
		},
		{
			"name": "账本形状：零边授予不得在账本外添形（公理一：凡后果必可说）",
			"steps": [
				{ "name": "无关系世界的授予提交后，relations 键仍缺席", "action": { "verb": "touch", "params": {} }, "expect": { "ok": true, "state": { "$world.relations": null, "player.touched": 1 } } }
			]
		},
		{
			"name": "静默刻聚合：被拦刻步独立成行，每刻恰有一个时间标记",
			"steps": [
				{ "name": "vault.tick 产出被守恒墙拦截：拦截行独立计时，不再并入 ×n", "tick": 1, "expect": { "tickDenied": true, "lines": ["✓ 流逝(1)：时间流逝。", "⏱ ✗ 封印纹丝不动。"] } }
			]
		},
		{
			"name": "指称解析按声明：字面字符串与实体 id 碰撞也不得解析，id 型属性解析为展示名",
			"steps": [
				{ "name": "字面保持字面，引用解析为名字", "action": { "verb": "tag", "params": {} }, "expect": { "ok": true, "lines": ["✓ 标记：你写下了标记。（你.便签: null → thing；你.指向: null → 那件东西）"] } }
			]
		},
		{
			"name": "形状封闭与边值契约：无哨兵引用、实体形状封闭、边值=账本值",
			"steps": [
				{ "name": "id 引用写空串：无哨兵——integrity 拒绝，整提交回滚（「无引用」由 null/缺席表达）", "action": { "verb": "blank", "params": {} }, "expect": { "ok": false, "reason": "世界没有回应", "state": { "player.ref": null } } },
				{ "name": "拒绝后的干净提交照常（回滚探针步）", "action": { "verb": "touch", "params": {} }, "expect": { "ok": true, "state": { "player.touched": 1, "player.ref": null } } },
				{ "name": "spawn 带实体形状外的顶层键：形状封闭拒绝（公理一「此外无物」）", "action": { "verb": "junkspawn", "params": {} }, "expect": { "ok": false, "reason": "世界没有回应", "state": { "$world.entities.2": null } } },
				{ "name": "边值=账本值：标量数组合法入账（与属性值同一形状契约）", "action": { "verb": "edgearr", "params": {} }, "expect": { "ok": true, "lines": ["✓ 数组边：你系了一条带标记的边。（你.标记.那件东西: null → 甲）"] } },
				{ "name": "对象形状不是账本值：提交翼拒绝（宽读契约的边界）", "action": { "verb": "edgeobj", "params": {} }, "expect": { "ok": false, "reason": "世界没有回应" } }
			]
		}
	]
}
