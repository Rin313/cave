{
	"game": "walltest",
	"name": "结构墙（冻结读态）",
	"scenarios": [
		{
			"name": "越权写在写入点即抛，活世界零污染；干净裁决与干净读不受影响",
			"steps": [
				{ "name": "干净动作：冻结不误伤", "action": { "verb": "touch", "params": {} }, "expect": { "ok": true, "reason": "触到", "state": { "player.touched": 1, "player.hp": 10 } } },
				{ "name": "规则越权写属性：冻结读态上写入即抛（严格模式 TypeError），授予不存在", "action": { "verb": "poke", "params": {} }, "expect": { "throws": "read only" } },
				{ "name": "规则越权写钟：q.world.time 同被冻结拦下——钟的唯一写者是落钟循环，按构造成立", "action": { "verb": "clockpoke", "params": {} }, "expect": { "throws": "read only" } },
				{ "name": "越权未遂后世界仍健康：时间未走、数值无漂移，干净动作照常", "action": { "verb": "touch", "params": {} }, "expect": { "ok": true, "state": { "player.touched": 2, "player.hp": 10 } } },
				{ "name": "系统越权写属性：刻步在系统写入点即抛", "tick": 1, "expect": { "throws": "read only" } }
			]
		}
	]
}
