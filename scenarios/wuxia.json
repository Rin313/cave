{
	"game": "wuxia",
	"name": "青峰派法则验证",
	"seed": 1,
	"scenarios": [
		{
			"name": "青峰入门：取剑、赠药、练功、切磋、行路",
			"steps": [
				{ "name": "拿起青锋剑", "action": { "verb": "take", "params": { "entity": "sword" } }, "expect": { "ok": true, "reason": "拿起", "state": { "sword.in": "player" } } },
				{ "name": "赠金创药给师兄", "action": { "verb": "give", "params": { "item": "pill", "to": "senior" } }, "expect": { "ok": true, "reason": "赠给", "state": { "pill.in": "senior" } } },
				{ "name": "打坐增长内力", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": true, "reason": "内力", "state": { "player.neili": 16, "player.stamina": 65 } } },
				{ "name": "持剑切磋胜师兄", "action": { "verb": "spar", "params": { "opponent": "senior" } }, "expect": { "ok": true, "reason": "胜", "state": { "player.sword": 5, "senior.stamina": 60 } } },
				{ "name": "前往藏经阁", "action": { "verb": "travel", "params": { "dest": "library" } }, "expect": { "ok": true, "reason": "藏经阁", "state": { "player.in": "library" } } },
				{ "name": "拿起心法残页", "action": { "verb": "take", "params": { "entity": "scroll" } }, "expect": { "ok": true, "reason": "拿起", "state": { "scroll.in": "player" } } }
			]
		},
		{
			"name": "切磋落败与养伤：受伤、禁战、恢复",
			"steps": [
				{ "name": "打坐一", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": true } },
				{ "name": "打坐二", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": true } },
				{ "name": "打坐三（体力降至 35）", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": true, "state": { "player.stamina": 35, "player.neili": 28 } } },
				{ "name": "与师父切磋落败受伤", "action": { "verb": "spar", "params": { "opponent": "master" } }, "expect": { "ok": true, "reason": "败", "state": { "player.injured": true, "player.stamina": 15 } } },
				{ "name": "带伤切磋被拒", "action": { "verb": "spar", "params": { "opponent": "master" } }, "expect": { "ok": false, "reason": "伤" } },
				{ "name": "时间流逝，伤势痊愈", "tick": 3, "expect": { "ok": true, "state": { "player.injured": false, "player.stamina": 45 } } }
			]
		},
		{
			"name": "法则边界：非法赠予、远距拿取、非法目的地",
			"steps": [
				{ "name": "赠未持握的青锋剑被拒", "action": { "verb": "give", "params": { "item": "sword", "to": "senior" } }, "expect": { "ok": false, "reason": "手里" } },
				{ "name": "隔空拿取藏经阁的残页被拒", "action": { "verb": "take", "params": { "entity": "scroll" } }, "expect": { "ok": false, "reason": "不在这里" } },
				{ "name": "原地赶路（幂等）", "action": { "verb": "travel", "params": { "dest": "yard" } }, "expect": { "ok": true, "reason": "已经" } },
				{ "name": "把玩家当目的地被拒", "action": { "verb": "travel", "params": { "dest": "player" } }, "expect": { "ok": false, "reason": "去的地方" } },
				{ "name": "连打坐一（体力 65）", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": true } },
				{ "name": "连打坐二（体力 50）", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": true } },
				{ "name": "连打坐三（体力 35）", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": true } },
				{ "name": "连打坐四（体力 20）", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": true } },
				{ "name": "连打坐五（体力 5）", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": true, "state": { "player.stamina": 5 } } },
				{ "name": "体力不足打坐被拒", "action": { "verb": "meditate", "params": {} }, "expect": { "ok": false, "reason": "乏力" } }
			]
		}
	]
}
