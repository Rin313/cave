{
	"game": "cave",
	"name": "法则引擎涌现验证",
	"scenarios": [
		{
			"name": "基础流程：取戒 → 开箱 → 拿蜡 → 点燃 → 放下",
			"steps": [
				{ "name": "直接拿戒指失败（固定在骷髅上）", "action": { "verb": "move", "params": { "entity": "ring", "dest": "player" } }, "expect": { "ok": false, "reason": "固定" } },
				{ "name": "解下铜戒", "action": { "verb": "set", "params": { "entity": "ring", "prop": "attachedTo", "value": null } }, "expect": { "ok": true, "reason": "解下" } },
				{ "name": "戒指已到手", "action": { "verb": "move", "params": { "entity": "ring", "dest": "player" } }, "expect": { "ok": true, "reason": "手中" } },
				{ "name": "打开木箱", "action": { "verb": "set", "params": { "entity": "chest", "prop": "open", "value": true } }, "expect": { "ok": true, "reason": "打开" } },
				{ "name": "取出蜡烛", "action": { "verb": "move", "params": { "entity": "candle", "dest": "player" } }, "expect": { "ok": true, "reason": "拿起" } },
				{ "name": "用火把点燃蜡烛", "action": { "verb": "use", "params": { "source": "torch", "target": "candle" } }, "expect": { "ok": true, "reason": "点燃" } },
				{ "name": "把火把放在地上", "action": { "verb": "move", "params": { "entity": "torch", "dest": "cave" } }, "expect": { "ok": true, "reason": "放到" } }
			]
		},
		{
			"name": "涌现：点燃木箱 → 火蔓延 → 内容物被烧毁",
			"steps": [
				{ "name": "点燃木箱（从未写过的交互）", "action": { "verb": "use", "params": { "source": "torch", "target": "chest" } }, "expect": { "ok": true, "reason": "燃" } },
				{ "name": "tick：火焰蔓延到箱内蜡烛", "tick": 1, "expect": { "ok": true, "reason": "蔓延" } },
				{ "name": "tick：火继续烧", "tick": 1, "expect": { "ok": true } },
				{ "name": "tick：木箱与蜡烛烧成灰烬", "tick": 1, "expect": { "ok": true, "reason": "灰烬", "state": { "chest.material": "ash", "candle.material": "ash", "chest.burning": false } } }
			]
		},
		{
			"name": "涌现：用铜戒撬门失败（拒绝带理由）",
			"steps": [
				{ "name": "用铜戒撬石门", "action": { "verb": "use", "params": { "source": "ring", "target": "door" } }, "expect": { "ok": false, "reason": "撬" } }
			]
		},
		{
			"name": "涌现：蜡烛塞进门缝 → 门卡住 → 抽出后恢复",
			"steps": [
				{ "name": "关着木箱里的蜡烛拿不到", "action": { "verb": "move", "params": { "entity": "candle", "dest": "player" } }, "expect": { "ok": false, "reason": "关着" } },
				{ "name": "打开木箱", "action": { "verb": "set", "params": { "entity": "chest", "prop": "open", "value": true } }, "expect": { "ok": true } },
				{ "name": "取出蜡烛", "action": { "verb": "move", "params": { "entity": "candle", "dest": "player" } }, "expect": { "ok": true } },
				{ "name": "把蜡烛塞进门缝", "action": { "verb": "move", "params": { "entity": "candle", "dest": "door" } }, "expect": { "ok": true, "reason": "卡住" } },
				{ "name": "门被卡住，打不开", "action": { "verb": "set", "params": { "entity": "door", "prop": "open", "value": true } }, "expect": { "ok": false, "reason": "卡住" } },
				{ "name": "把蜡烛抽出来", "action": { "verb": "move", "params": { "entity": "candle", "dest": "cave" } }, "expect": { "ok": true, "reason": "放到" } },
				{ "name": "门解卡，可以打开", "action": { "verb": "set", "params": { "entity": "door", "prop": "open", "value": true } }, "expect": { "ok": true, "reason": "打开" } }
			]
		},
		{
			"name": "涌现：铁钎撬开木箱，但撬不动石门",
			"steps": [
				{ "name": "用铁钎撬开木箱（硬物 > 木）", "action": { "verb": "use", "params": { "source": "crowbar", "target": "chest" } }, "expect": { "ok": true, "reason": "撬开", "state": { "chest.open": true } } },
				{ "name": "用铁钎撬石门失败（iron < stone）", "action": { "verb": "use", "params": { "source": "crowbar", "target": "door" } }, "expect": { "ok": false, "reason": "硬度" } }
			]
		},
		{
			"name": "涌现：燃着的火把放进木箱会被引燃",
			"steps": [
				{ "name": "打开木箱", "action": { "verb": "set", "params": { "entity": "chest", "prop": "open", "value": true } }, "expect": { "ok": true } },
				{ "name": "把燃着的火把放进木箱", "action": { "verb": "move", "params": { "entity": "torch", "dest": "chest" } }, "expect": { "ok": true, "reason": "放进" } },
				{ "name": "tick：火把引燃木箱", "tick": 1, "expect": { "ok": true, "reason": "点燃", "state": { "chest.burning": true } } },
				{ "name": "tick：木箱烧成灰烬", "tick": 3, "expect": { "ok": true, "reason": "灰烬", "state": { "chest.material": "ash", "chest.burning": false } } }
			]
		},
		{
			"name": "set 白名单：结构性属性拒绝直接写入",
			"steps": [
				{ "name": "set 直接改材质被拒", "action": { "verb": "set", "params": { "entity": "chest", "prop": "material", "value": "gold" } }, "expect": { "ok": false, "reason": "没有任何变化" } },
				{ "name": "set 直接传送被拒", "action": { "verb": "set", "params": { "entity": "torch", "prop": "in", "value": "player" } }, "expect": { "ok": false, "reason": "没有任何变化" } },
				{ "name": "set open 仍允许（法则声明的可写属性）", "action": { "verb": "set", "params": { "entity": "chest", "prop": "open", "value": true } }, "expect": { "ok": true } },
				{ "name": "set 解戒仍允许", "action": { "verb": "set", "params": { "entity": "ring", "prop": "attachedTo", "value": null } }, "expect": { "ok": true } }
			]
		},
		{
			"name": "开放通道：soft 通道约束校验（do 动词）",
			"steps": [
				{
					"name": "刻痕：前置事实为真 + marked 是 soft 属性 → 授予",
					"action": {
						"verb": "do",
						"params": {},
						"proof": {
							"claims": [
								{ "k": "reach", "e": { "k": "lit", "v": "crowbar" } },
								{ "k": "in", "a": { "k": "prop", "e": { "k": "lit", "v": "crowbar" }, "p": "material" }, "set": ["iron", "steel"] },
								{ "k": "in", "a": { "k": "prop", "e": { "k": "lit", "v": "chest" }, "p": "material" }, "set": ["wood"] }
							],
							"desired": [
								{ "op": "set", "entity": "chest", "prop": "marked", "value": true }
							],
							"reason": "你在木箱上刻下了一道刻痕。"
						}
					},
					"expect": { "ok": true, "reason": "刻痕", "state": { "chest.marked": true } }
				},
				{
					"name": "声明为假的前置事实被拒（断言不成立）",
					"action": {
						"verb": "do",
						"params": {},
						"proof": {
							"claims": [
								{ "k": "cmp", "a": { "k": "prop", "e": { "k": "lit", "v": "crowbar" }, "p": "in" }, "op": "eq", "b": { "k": "lit", "v": "player" } },
								{ "k": "reach", "e": { "k": "lit", "v": "crowbar" } }
							],
							"desired": [
								{ "op": "set", "entity": "door", "prop": "marked", "value": true }
							]
						}
					},
					"expect": { "ok": false, "reason": "前置事实" }
				},
				{
					"name": "凭空改变材质被拒（material 是 law）",
					"action": {
						"verb": "do",
						"params": {},
						"proof": {
							"claims": [{ "k": "reach", "e": { "k": "lit", "v": "crowbar" } }],
							"desired": [
								{ "op": "set", "entity": "torch", "prop": "material", "value": "gold" }
							]
						}
					},
					"expect": { "ok": false, "reason": "世界法则", "state": { "torch.material": "wood" } }
				},
				{
					"name": "传送不可搬动物体被拒（in 是 law）",
					"action": {
						"verb": "do",
						"params": {},
						"proof": {
							"claims": [{ "k": "reach", "e": { "k": "lit", "v": "chest" } }],
							"desired": [
								{ "op": "set", "entity": "chest", "prop": "in", "value": "player" }
							]
						}
					},
					"expect": { "ok": false, "reason": "世界法则", "state": { "chest.in": "cave" } }
				},
				{
					"name": "凭空点燃被拒（burning 是 law）",
					"action": {
						"verb": "do",
						"params": {},
						"proof": {
							"claims": [{ "k": "reach", "e": { "k": "lit", "v": "crowbar" } }],
							"desired": [
								{ "op": "set", "entity": "chest", "prop": "burning", "value": true }
							]
						}
					},
					"expect": { "ok": false, "reason": "世界法则" }
				},
				{
					"name": "实体生灭不能经此通道（须经法则）",
					"action": {
						"verb": "do",
						"params": {},
						"proof": {
							"claims": [{ "k": "reach", "e": { "k": "lit", "v": "crowbar" } }],
							"desired": [
								{ "op": "spawn", "kind": "item", "name": "石子", "props": { "in": "cave" } }
							]
						}
					},
					"expect": { "ok": false, "reason": "生灭" }
				},
				{
					"name": "exists 断言同样支撑归因",
					"action": {
						"verb": "do",
						"params": {},
						"proof": {
							"claims": [
								{ "k": "exists", "e": { "k": "lit", "v": "crowbar" } },
								{ "k": "exists", "e": { "k": "lit", "v": "door" } }
							],
							"desired": [
								{ "op": "set", "entity": "door", "prop": "marked", "value": true }
							],
							"reason": "你在石门上也刻下了一道刻痕。"
						}
					},
					"expect": { "ok": true, "reason": "刻痕", "state": { "door.marked": true } }
				}
			]
		},
		{
			"name": "经济守恒：铜币总量不变（era/DoL 资源模式）",
			"steps": [
				{
					"name": "AI 经 do 通道凭空铸币被拒（coins 是 law）",
					"action": {
						"verb": "do",
						"params": {},
						"proof": {
							"claims": [{ "k": "reach", "e": { "k": "lit", "v": "crowbar" } }],
							"desired": [
								{ "op": "inc", "entity": "player", "prop": "coins", "by": 500 }
							]
						}
					},
					"expect": { "ok": false, "reason": "世界法则", "state": { "player.coins": 40 } }
				},
				{
					"name": "set 动词直接改铜币被拒",
					"action": { "verb": "set", "params": { "entity": "player", "prop": "coins", "value": 9999 } },
					"expect": { "ok": false, "reason": "没有任何变化", "state": { "player.coins": 40 } }
				},
				{
					"name": "正常行动后铜币守恒不变式仍成立",
					"action": { "verb": "move", "params": { "entity": "crowbar", "dest": "player" } },
					"expect": { "ok": true, "state": { "player.coins": 40 } }
				}
			]
		},
		{
			"name": "级联后果：抽出楔子经完整法则解卡（预设 move 动词）",
			"steps": [
				{ "name": "打开木箱", "action": { "verb": "set", "params": { "entity": "chest", "prop": "open", "value": true } }, "expect": { "ok": true } },
				{ "name": "取出蜡烛", "action": { "verb": "move", "params": { "entity": "candle", "dest": "player" } }, "expect": { "ok": true } },
				{ "name": "塞入门缝卡门", "action": { "verb": "move", "params": { "entity": "candle", "dest": "door" } }, "expect": { "ok": true, "reason": "卡住" } },
				{
					"name": "用 move 抽出蜡烛，门解卡（move.withWedge 完整级联）",
					"action": { "verb": "move", "params": { "entity": "candle", "dest": "cave" } },
					"expect": { "ok": true, "reason": "放到", "state": { "candle.in": "cave", "door.jammed": null, "door.wedgedBy": null } }
				}
			]
		}
	]
}
