{
	"game": "village",
	"name": "era/DoL 极研究探针（河畔村）",
	"scenarios": [
		{
			"name": "时间与数值互锁：歇息/流逝/进食/饥饿/昏迷/醒来",
			"steps": [
				{ "name": "歇息恢复", "action": { "verb": "rest", "params": {} }, "expect": { "ok": true, "reason": "缓过劲", "state": { "player.hp": 58, "player.satiety": 55, "player.fatigue": 0 } } },
				{ "name": "时间流逝一个时段：疲劳+2，饱腹-6", "tick": 1, "expect": { "ok": true, "state": { "player.fatigue": 2, "player.satiety": 49 } } },
				{ "name": "进食：浆果-1，饱腹+25，体力+5", "action": { "verb": "eat", "params": {} }, "expect": { "ok": true, "state": { "player.berries": 1, "player.satiety": 74, "player.hp": 63 } } },
				{ "name": "连续挨饿 13 个时段：饱腹耗尽，体力开始被抽干", "tick": 13, "expect": { "ok": true, "state": { "player.satiety": 0, "player.hp": 59 } } },
				{ "name": "再饿 15 个时段：体力见底，昏迷倒地", "tick": 15, "expect": { "ok": true, "state": { "player.down": true, "player.hp": 0 } } },
				{ "name": "昏迷中歇息：醒来恢复", "action": { "verb": "rest", "params": {} }, "expect": { "ok": true, "reason": "醒来", "state": { "player.down": false, "player.hp": 30, "player.fatigue": 0, "player.satiety": 10 } } }
			]
		},
		{
			"name": "经济守恒：买卖米，铜币总量不变",
			"steps": [
				{ "name": "买米：40 → 30", "action": { "verb": "buy", "params": {} }, "expect": { "ok": true, "reason": "买", "state": { "player.coins": 30, "merchant.coins": 90, "flour.in": "player" } } },
				{ "name": "卖米：30 → 35", "action": { "verb": "sell", "params": {} }, "expect": { "ok": true, "reason": "卖", "state": { "player.coins": 35, "merchant.coins": 85, "flour.in": "village" } } },
				{ "name": "买米：35 → 25", "action": { "verb": "buy", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 25 } } },
				{ "name": "卖米：25 → 30", "action": { "verb": "sell", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 30 } } },
				{ "name": "买米：30 → 20", "action": { "verb": "buy", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 20 } } },
				{ "name": "卖米：20 → 25", "action": { "verb": "sell", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 25 } } },
				{ "name": "买米：25 → 15", "action": { "verb": "buy", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 15 } } },
				{ "name": "卖米：15 → 20", "action": { "verb": "sell", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 20 } } },
				{ "name": "买米：20 → 10", "action": { "verb": "buy", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 10 } } },
				{ "name": "卖米：10 → 15", "action": { "verb": "sell", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 15 } } },
				{ "name": "买米：15 → 5", "action": { "verb": "buy", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 5 } } },
				{ "name": "卖米：5 → 10", "action": { "verb": "sell", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 10 } } },
				{ "name": "买米：10 → 0", "action": { "verb": "buy", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 0 } } },
				{ "name": "卖米：0 → 5", "action": { "verb": "sell", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 5 } } },
				{ "name": "钱不够被拒，守恒不被打破", "action": { "verb": "buy", "params": {} }, "expect": { "ok": false, "reason": "钱不够", "state": { "player.coins": 5, "merchant.coins": 115 } } }
			]
		},
		{
			"name": "关系边耦合经济：信任升到 2 后米价打八折",
			"steps": [
				{ "name": "交谈：信任 0 → 1", "action": { "verb": "talk", "params": { "target": "merchant" } }, "expect": { "ok": true, "reason": "亲近" } },
				{ "name": "原价买米：40 → 30", "action": { "verb": "buy", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 30 } } },
				{ "name": "卖米回笼：30 → 35", "action": { "verb": "sell", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 35 } } },
				{ "name": "再交谈：信任 1 → 2", "action": { "verb": "talk", "params": { "target": "merchant" } }, "expect": { "ok": true, "reason": "亲近" } },
				{ "name": "折扣价买米：35 → 27（信任驱动米价）", "action": { "verb": "buy", "params": {} }, "expect": { "ok": true, "state": { "player.coins": 27 } } }
			]
		},
		{
			"name": "顺序过程：修井阶段链（清理 → 修葺 → 封底，不可跳步）",
			"steps": [
				{ "name": "未清理就修葺被拒（顺序守卫）", "action": { "verb": "fix", "params": {} }, "expect": { "ok": false, "reason": "顺序", "state": { "well.phase": 0 } } },
				{ "name": "清理枯井：阶段 0 → 1", "action": { "verb": "clear", "params": {} }, "expect": { "ok": true, "reason": "清理", "state": { "well.phase": 1 } } },
				{ "name": "没拿木料修井被拒", "action": { "verb": "fix", "params": {} }, "expect": { "ok": false, "reason": "木料", "state": { "well.phase": 1 } } },
				{ "name": "拾取木料", "action": { "verb": "gather", "params": { "entity": "timber" } }, "expect": { "ok": true, "reason": "拾起", "state": { "timber.in": "player" } } },
				{ "name": "修葺：阶段 1 → 2", "action": { "verb": "fix", "params": {} }, "expect": { "ok": true, "reason": "加固", "state": { "well.phase": 2 } } },
				{ "name": "封底：阶段 2 → 3，清泉涌出，赏 10 铜币", "action": { "verb": "seal", "params": {} }, "expect": { "ok": true, "reason": "清泉", "state": { "well.phase": 3, "well.supply": true, "player.coins": 50, "merchant.coins": 70 } } },
				{ "name": "修好后想再清理被拒（阶段守卫不放过）", "action": { "verb": "clear", "params": {} }, "expect": { "ok": false, "reason": "顺序", "state": { "well.phase": 3 } } },
				{ "name": "重复封底被拒", "action": { "verb": "seal", "params": {} }, "expect": { "ok": false, "reason": "顺序", "state": { "well.phase": 3 } } }
			]
		},
		{
			"name": "顺序过程：驱逐野狗（roll 随机伤害，确定性可验证）",
			"steps": [
				{ "name": "驱逐野狗：roll 骰子伤害 -4，狗被赶跑", "action": { "verb": "subdue", "params": { "dog": "dog" } }, "expect": { "ok": true, "reason": "赶跑", "state": { "dog.alive": false, "player.hp": 46 } } },
				{ "name": "tick 后同样的动作伤害随世界时间变化（roll 是 World 纯函数）", "tick": 1, "expect": { "ok": true } },
				{ "name": "再驱逐被拒（已经不在了）", "action": { "verb": "subdue", "params": { "dog": "dog" } }, "expect": { "ok": false, "reason": "不在这里" } }
			]
		},
		{
			"name": "随机判定：scout 骰子门槛（t0 命中 / t1 落空，roll 纯函数可验证）",
			"steps": [
				{ "name": "t0 侦察：骰子=3 命中，捡到 2 铜币（守恒：店主账上扣）", "action": { "verb": "scout", "params": {} }, "expect": { "ok": true, "reason": "捡到", "state": { "player.coins": 42, "merchant.coins": 78 } } },
				{ "name": "tick 1：时刻变为 1", "tick": 1, "expect": { "ok": true } },
				{ "name": "t1 侦察：骰子=1 落空，一无所获", "action": { "verb": "scout", "params": {} }, "expect": { "ok": false, "reason": "一无所获", "state": { "player.coins": 42, "merchant.coins": 78 } } }
			]
		},
		{
			"name": "era 语境结构性墙：无自由动作动词（do 已移除），凭空铸币被拒",
			"steps": [
				{ "name": "自由动作动词不存在：do 被拒为未知动词，铜币不被改变", "action": { "verb": "do", "params": {} }, "expect": { "ok": false, "reason": "不认识", "state": { "player.coins": 40 } } },
				{ "name": "正常行动后守恒不变式仍成立", "action": { "verb": "gather", "params": { "entity": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 40 } } }
			]
		}
	]
}
