{
	"game": "village",
	"name": "era/DoL 极研究探针（河畔村）",
	"scenarios": [
		{
			"name": "时间与数值互锁：歇息/流逝/进食/饥饿/昏迷/醒来",
			"steps": [
				{ "name": "歇息恢复（授予一刻在裁决边界内流逝：疲劳+2、饱腹-6）", "action": { "verb": "rest", "params": {} }, "expect": { "ok": true, "reason": "缓过劲", "state": { "player.hp": 58, "player.satiety": 49, "player.fatigue": 2 } } },
				{ "name": "进食：浆果-1，饱腹+25，体力+5", "action": { "verb": "eat", "params": {} }, "expect": { "ok": true, "state": { "player.berries": 1, "player.satiety": 74, "player.hp": 63 } } },
				{ "name": "连续挨饿 13 个时段：饱腹耗尽，体力开始被抽干", "tick": 13, "expect": { "ok": true, "state": { "player.satiety": 0, "player.hp": 59 } } },
				{ "name": "再饿 15 个时段：体力见底，昏迷倒地", "tick": 15, "expect": { "ok": true, "state": { "player.down": true, "player.hp": 0 } } },
				{ "name": "昏迷中歇息：醒来恢复（一夜的授予刻真实代谢：饥饿在睡眠中涌现）", "action": { "verb": "rest", "params": {} }, "expect": { "ok": true, "reason": "醒来", "state": { "player.down": false, "player.hp": 18, "player.fatigue": 8, "player.satiety": 0 } } }
			]
		},
		{
			"name": "经济守恒：买卖米，铜币总量不变",
			"steps": [
				{ "name": "买米：40 → 30", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "reason": "买", "state": { "player.coins": 30, "merchant.coins": 90, "flour.in": "player" } } },
				{ "name": "卖米：30 → 35", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": true, "reason": "卖", "state": { "player.coins": 35, "merchant.coins": 85, "flour.in": "village" } } },
				{ "name": "买米：35 → 25", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 25 } } },
				{ "name": "卖米：25 → 30", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 30 } } },
				{ "name": "买米：30 → 20", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 20 } } },
				{ "name": "卖米：20 → 25", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 25 } } },
				{ "name": "买米：25 → 15", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 15 } } },
				{ "name": "卖米：15 → 20", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 20 } } },
				{ "name": "买米：20 → 10", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 10 } } },
				{ "name": "卖米：10 → 15", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 15 } } },
				{ "name": "买米：15 → 5", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 5 } } },
				{ "name": "卖米：5 → 10", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 10 } } },
				{ "name": "买米：10 → 0", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 0 } } },
				{ "name": "卖米：0 → 5", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 5 } } },
				{ "name": "钱不够被拒，守恒不被打破", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": false, "reason": "钱不够", "state": { "player.coins": 5, "merchant.coins": 115 } } }
			]
		},
		{
			"name": "关系边耦合经济：卖家信任升到 2 后米价折价",
			"steps": [
				{ "name": "交谈：信任 0 → 1", "action": { "verb": "talk", "params": { "target": "merchant" } }, "expect": { "ok": true, "reason": "亲近" } },
				{ "name": "原价买米：40 → 30", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 30 } } },
				{ "name": "卖米回笼：30 → 35", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 35 } } },
				{ "name": "再交谈：信任 1 → 2", "action": { "verb": "talk", "params": { "target": "merchant" } }, "expect": { "ok": true, "reason": "亲近" } },
				{ "name": "折价买米：35 → 27（信任驱动米价）", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 27 } } }
			]
		},
		{
			"name": "顺序过程：修井阶段链（清理 → 加固 → 封底，不可跳步）",
			"steps": [
				{ "name": "阶段 0 推进一步 = 清理", "action": { "verb": "repair", "params": { "structure": "well" } }, "expect": { "ok": true, "reason": "清理", "state": { "well.phase": 1 } } },
				{ "name": "没拿木料推进被拒（材料守卫）", "action": { "verb": "repair", "params": { "structure": "well" } }, "expect": { "ok": false, "reason": "木料", "state": { "well.phase": 1 } } },
				{ "name": "拾取木料", "action": { "verb": "gather", "params": { "entity": "timber" } }, "expect": { "ok": true, "reason": "拾起", "state": { "timber.in": "player" } } },
				{ "name": "加固：阶段 1 → 2", "action": { "verb": "repair", "params": { "structure": "well" } }, "expect": { "ok": true, "reason": "加固", "state": { "well.phase": 2 } } },
				{ "name": "封底：阶段 2 → 3，清泉涌出，赏金由出资人支付", "action": { "verb": "repair", "params": { "structure": "well" } }, "expect": { "ok": true, "reason": "清泉", "state": { "well.phase": 3, "well.supply": true, "player.coins": 50, "merchant.coins": 70 } } },
				{ "name": "完工后再修被拒（阶段守卫不放过）", "action": { "verb": "repair", "params": { "structure": "well" } }, "expect": { "ok": false, "reason": "不需要", "state": { "well.phase": 3 } } }
			]
		},
		{
			"name": "顺序过程：驱逐野狗（roll 随机伤害，确定性可验证）",
			"steps": [
				{ "name": "驱逐野狗：roll 骰子伤害 -5，狗被赶跑", "action": { "verb": "subdue", "params": { "dog": "dog" } }, "expect": { "ok": true, "reason": "赶跑", "state": { "dog.alive": false, "player.hp": 45 } } },
				{ "name": "tick 后同样的动作伤害随世界时间变化（roll 是 World 纯函数）", "tick": 1, "expect": { "ok": true } },
				{ "name": "再驱逐被拒（已经不在了）", "action": { "verb": "subdue", "params": { "dog": "dog" } }, "expect": { "ok": false, "reason": "不在这里" } }
			]
		},
		{
			"name": "随机判定：scout 骰子门槛 + 村里散落铜币有限（t0 命中 / t1 落空）",
			"steps": [
				{ "name": "t0 侦察：骰子=3 命中，捡到 2 铜币（守恒：村里散落的铜币扣）", "action": { "verb": "scout", "params": {} }, "expect": { "ok": true, "reason": "捡到", "state": { "player.coins": 42, "village.coins": 2 } } },
				{ "name": "t1 侦察：骰子=1 落空——命运随上一动作授予的一刻改变（roll 是 World 纯函数）", "action": { "verb": "scout", "params": {} }, "expect": { "ok": false, "reason": "一无所获", "state": { "player.coins": 42, "village.coins": 2 } } }
			]
		},
		{
			"name": "era 语境结构性墙：无自由动作动词（do 已移除），凭空铸币被拒",
			"steps": [
				{ "name": "自由动作动词不存在：do 触发前置条件违约（内核契约），铜币不被改变", "action": { "verb": "do", "params": {} }, "expect": { "protocol": "action.unknown", "state": { "player.coins": 40 } } },
				{ "name": "正常行动后守恒不变式仍成立", "action": { "verb": "gather", "params": { "entity": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 40 } } }
			]
		},
		{
			"name": "时间门控：入夜歇业、白天恢复",
			"steps": [
				{ "name": "先买米备着：40 → 30", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 30, "merchant.coins": 90 } } },
				{ "name": "入夜（时刻 3）", "tick": 3, "expect": { "ok": true } },
				{ "name": "入夜卖米被拒（歇下）", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": false, "reason": "歇下" } },
				{ "name": "入夜买谷物被拒（打烊）", "action": { "verb": "buy", "params": { "goods": "wheatfield" } }, "expect": { "ok": false, "reason": "打烊" } },
				{ "name": "天亮（时刻 4）", "tick": 1, "expect": { "ok": true } },
				{ "name": "天亮卖米恢复：30 → 35", "action": { "verb": "sell", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 35, "merchant.coins": 85 } } },
				{ "name": "白天恢复买米：35 → 25", "action": { "verb": "buy", "params": { "goods": "flour" } }, "expect": { "ok": true, "state": { "player.coins": 25, "merchant.coins": 95 } } }
			]
		},
		{
			"name": "谷物经济：动态价格、守恒",
			"steps": [
				{ "name": "买谷物（存粮 10，价 3）", "action": { "verb": "buy", "params": { "goods": "wheatfield" } }, "expect": { "ok": true, "state": { "player.coins": 37, "farmer.coins": 63, "wheatfield.grain": 9, "player.grain": 1 } } },
				{ "name": "买谷物（存粮 9，价 4）", "action": { "verb": "buy", "params": { "goods": "wheatfield" } }, "expect": { "ok": true, "state": { "player.coins": 33, "wheatfield.grain": 8 } } },
				{ "name": "买谷物（存粮 8，价 5）", "action": { "verb": "buy", "params": { "goods": "wheatfield" } }, "expect": { "ok": true, "state": { "player.coins": 28, "farmer.coins": 72, "wheatfield.grain": 7, "player.grain": 3 } } },
				{ "name": "吃谷物：饱腹 +30、体力 +6", "action": { "verb": "eatGrain", "params": {} }, "expect": { "ok": true, "state": { "player.grain": 2, "player.satiety": 90, "player.hp": 56 } } },
				{ "name": "吃光剩余谷物", "action": { "verb": "eatGrain", "params": {} }, "expect": { "ok": true, "state": { "player.grain": 1 } } },
				{ "name": "吃最后一份", "action": { "verb": "eatGrain", "params": {} }, "expect": { "ok": true, "state": { "player.grain": 0 } } },
				{ "name": "没有谷物可吃", "action": { "verb": "eatGrain", "params": {} }, "expect": { "ok": false, "reason": "谷物", "state": { "player.grain": 0 } } }
			]
		},
		{
			"name": "井水资源：枯井不可汲、封底后汲水饮水",
			"steps": [
				{ "name": "枯井打不出水", "action": { "verb": "draw", "params": { "source": "well" } }, "expect": { "ok": false, "reason": "枯" } },
				{ "name": "修井第一步：清理", "action": { "verb": "repair", "params": { "structure": "well" } }, "expect": { "ok": true } },
				{ "name": "拾取木料", "action": { "verb": "gather", "params": { "entity": "timber" } }, "expect": { "ok": true } },
				{ "name": "修井第二步：加固", "action": { "verb": "repair", "params": { "structure": "well" } }, "expect": { "ok": true } },
				{ "name": "封底，清泉涌出（10 桶水）", "action": { "verb": "repair", "params": { "structure": "well" } }, "expect": { "ok": true, "state": { "well.supply": true, "well.water": 10 } } },
				{ "name": "汲水：井水 10 → 9，随身 1", "action": { "verb": "draw", "params": { "source": "well" } }, "expect": { "ok": true, "state": { "well.water": 9, "player.water": 1 } } },
				{ "name": "饮水：消耗 1 份水，疲劳 -20（此前六次动作已真实流逝六刻），体力 +3", "action": { "verb": "drink", "params": {} }, "expect": { "ok": true, "state": { "player.water": 0, "player.fatigue": -8, "player.hp": 53 } } }
			]
		},
		{
			"name": "关系网络：talk 泛化到任意 NPC + 老农信任折价",
			"steps": [
				{ "name": "与老农交谈（信任 1）", "action": { "verb": "talk", "params": { "target": "farmer" } }, "expect": { "ok": true, "reason": "亲近" } },
				{ "name": "信任不足：原价买谷物（价 3）", "action": { "verb": "buy", "params": { "goods": "wheatfield" } }, "expect": { "ok": true, "state": { "player.coins": 37, "farmer.coins": 63 } } },
				{ "name": "与老农再交谈（信任 2）", "action": { "verb": "talk", "params": { "target": "farmer" } }, "expect": { "ok": true } },
				{ "name": "信任折价：价 2（存粮 9）", "action": { "verb": "buy", "params": { "goods": "wheatfield" } }, "expect": { "ok": true, "state": { "player.coins": 35, "farmer.coins": 65 } } }
			]
		}
	]
}
